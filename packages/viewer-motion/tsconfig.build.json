{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "jsx": "react-jsx",
    "rootDir": "./src",
    "declaration": true,
    "declarationMap": false,
    "noEmit": false,
    "outDir": "./dist",
    "sourceMap": false
  },
  "include": ["./src/**/*"],
  "exclude": ["**/*.test.ts", "**/*.test.tsx"]
}
