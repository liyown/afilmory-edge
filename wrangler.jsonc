{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "afilmory-edge",
  "main": "apps/edge/.cloudflare/output/v0/workers/default/bundle/index.js",
  "compatibility_date": "2026-10-18",
  "assets": {
    "binding": "ASSETS",
    "directory": "apps/edge/.cloudflare/output/v0/workers/default/assets",
    "not_found_handling": "none",
    "run_worker_first": true
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "afilmory-db",
      "database_id": "00000000-0000-0000-0000-000000000000",
      "migrations_dir": "be/packages/db/migrations"
    }
  ],
  "kv_namespaces": [
    {
      "binding": "CACHE",
      "id": "00000000000000000000000000000000"
    }
  ],
  "r2_buckets": [
    {
      "binding": "PHOTOS",
      "bucket_name": "afilmory-photos"
    }
  ],
  "triggers": {
    "crons": ["0 * * * *", "30 2 * * *"]
  },
  "observability": {
    "enabled": true
  }
}
