{
  "name": "@afilmory/edge",
  "type": "module",
  "private": true,
  "scripts": {
    "build": "pnpm build:spas && pnpm sync-assets && cf build",
    "build:dashboard": "pnpm -C ../../be/apps/dashboard build",
    "build:spas": "pnpm build:web && pnpm build:dashboard",
    "build:web": "AFILMORY_EMBED_SITE_CONFIG=false pnpm -C ../../apps/web exec vite build",
    "deploy": "cf deploy",
    "dev": "cf dev",
    "sync-assets": "bash scripts/sync-assets.sh",
    "typecheck": "cf workers types && tsc"
  },
  "dependencies": {
    "@afilmory/db": "workspace:*",
    "@afilmory/env": "workspace:*",
    "@afilmory/typing": "workspace:*",
    "@tsuki-hono/common": "0.0.6",
    "@tsuki-hono/core": "0.0.6",
    "aws4fetch": "^1.0.20",
    "exifr": "^7.1.3",
    "hono": "4.13.13",
    "reflect-metadata": "0.2.2",
    "tsyringe": "4.10.0",
    "workers-og": "0.0.27"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "2.0.0-beta.v.1",
    "@swc/core": "1.16.18",
    "@types/node": "26.6.5",
    "cf": "1.0.0-beta.18",
    "typescript": "^7.0.2",
    "unplugin-swc": "2.0.0",
    "vite": "8.3.4"
  }
}
