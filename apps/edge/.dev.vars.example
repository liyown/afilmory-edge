# Local-only Worker secrets for `cf dev`. Copy to `.dev.vars` and replace values.
# Production values are set with
# `cf workers secrets update CONFIG_ENCRYPTION_KEY --type secret_text --worker afilmory-edge`
# (and optionally BETTER_AUTH_SECRET; it falls back to CONFIG_ENCRYPTION_KEY).
CONFIG_ENCRYPTION_KEY=local-development-encryption-key
BETTER_AUTH_SECRET=local-development-better-auth-secret

# First-run owner setup token; shown in the dashboard login page when the D1
# database has no user yet.
SETUP_TOKEN=local-development-setup-token

# Object storage. The S3-compatible credentials below are used by default.
# For the one-click R2 driver, start the dev server with
# `STORAGE_DRIVER=r2 pnpm dev` so the config declares the PHOTOS binding.

# S3-compatible object storage (Aliyun OSS). The endpoint is the virtual-hosted
# bucket URL, so the bucket name is part of the host. Media is always served
# through the Worker's `/media/*` proxy; the bucket stays private because it
# also holds D1 backups under `backups/d1/`.
S3_ENDPOINT=https://<bucket>.s3.oss-<region>.aliyuncs.com
S3_REGION=<region>
S3_ACCESS_KEY_ID=disabled
S3_SECRET_ACCESS_KEY=disabled
