# Local-only Worker secrets for `cf dev`. Copy to `.dev.vars` and replace values.
# Production values are set with `cf secret put CONFIG_ENCRYPTION_KEY` (and
# optionally BETTER_AUTH_SECRET; it falls back to CONFIG_ENCRYPTION_KEY).
CONFIG_ENCRYPTION_KEY=local-development-encryption-key
BETTER_AUTH_SECRET=local-development-better-auth-secret

# Direct-to-R2 presigned uploads (T4.1). `disabled` makes the Worker proxy
# uploads through itself, which is fine locally but bounded by the Worker body
# size. Production must set real values (`cf secret put <NAME>`).
R2_ACCOUNT_ID=disabled
R2_ACCESS_KEY_ID=disabled
R2_SECRET_ACCESS_KEY=disabled
R2_BUCKET_NAME=afilmory-photos
# Keep `/media` or use a Worker-controlled hostname. Never use a public bucket
# or r2.dev URL: the bucket also holds private D1 backups under `backups/d1/`.
R2_PUBLIC_BASE_URL=/media
