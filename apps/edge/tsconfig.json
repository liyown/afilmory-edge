{
  "compilerOptions": {
    "target": "es2024",
    "jsx": "react-jsx",
    "lib": [
      "es2024"
    ],
    "emitDecoratorMetadata": true,
    "experimentalDecorators": true,
    "module": "preserve",
    "moduleResolution": "bundler",
    "paths": {
      "@core/*": ["../../be/apps/core/src/*"]
    },
    "types": [
      "node"
    ],
    "allowImportingTsExtensions": true,
    "strict": true,
    "noImplicitAny": false,
    "noEmit": true,
    "isolatedModules": true,
    "verbatimModuleSyntax": true,
    "skipLibCheck": true
  },
  "include": [
    "src",
    "cloudflare.config.ts",
    ".cloudflare/types"
  ]
}
