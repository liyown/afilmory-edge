{
  "name": "@afilmory/be",
  "type": "module",
  "version": "1.0.0",
  "private": true,
  "author": "Innei",
  "main": "index.js",
  "scripts": {
    "db:generate": "pnpm --filter core db:generate",
    "lint": "eslint . --fix",
    "prepare": "simple-git-hooks",
    "test": "pnpm run -r test"
  },
  "dependencies": {
    "prettier": "3.9.10"
  },
  "devDependencies": {
    "eslint": "10.12.0",
    "eslint-config-hyoban": "7.0.3",
    "jiti": "2.7.0",
    "lint-staged": "17.6.0",
    "simple-git-hooks": "2.14.0",
    "typescript": "catalog:"
  },
  "simple-git-hooks": {
    "pre-commit": "npx lint-staged"
  },
  "lint-staged": {
    "*": "eslint --fix",
    "*.{js,jsx,ts,tsx,json,css,md}": "prettier --write"
  }
}
